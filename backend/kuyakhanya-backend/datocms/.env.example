# DatoCMS — Kuyakhanya FM (Project 229086)
# Get tokens at https://kuyakhanya-fm.admin.datocms.com/admin/access_tokens
# Free plan: 10 models, GraphQL, 1000 records — no trial.

# Full-access token (CMA) — server only, never expose to client
# Used by datocms/migrate.mjs to create models/records
DATOCMS_API_TOKEN=YOUR_FULL_ACCESS_TOKEN_HERE
DATOCMS_ENVIRONMENT=main

# Readonly token (Content Delivery API) — used by frontend at build/runtime
# Create a "Readonly" token with GraphQL endpoint enabled
DATOCMS_READONLY_API_TOKEN=YOUR_READONLY_TOKEN_HERE
# Alternative name used by frontend (Next.js public prefix):
NEXT_PUBLIC_DATOCMS_API_TOKEN=YOUR_READONLY_TOKEN_HERE
NEXT_PUBLIC_DATOCMS_ENVIRONMENT=main

# Supabase (Postgres) — optional if you also use Strapi; DatoCMS itself is cloud-hosted
# Keep for audit logs / contact form submissions if needed
# See ../supabase/schema.sql
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Cloudinary — media for DatoCMS uploads (DatoCMS has built-in CDN but you can mirror)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://key:secret@cloud_name
