{
  "hosting": [
    {
      "site": "kuyakhanyafm",
      "public": "frontend/kuyakhanya-frontend/out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "/images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] },
        { "source": "**/*.apk", "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"kuyakhanya-fm.apk\"" }
        ] },
        { "source": "/opengraph-image", "headers": [{ "key": "Content-Type", "value": "image/png" }] },
        { "source": "/**", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "redirects": [
        { "source": "/services", "destination": "/media-centre", "type": 301 }
      ],
      "cleanUrls": true
    },
    {
      "site": "admin-kuyakhanyafm",
      "public": "frontend/kuyakhanya-frontend/out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "/images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] },
        { "source": "**/*.apk", "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"kuyakhanya-fm.apk\"" }
        ] },
        { "source": "/opengraph-image", "headers": [{ "key": "Content-Type", "value": "image/png" }] },
        { "source": "/**", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "redirects": [
        { "source": "/services", "destination": "/media-centre", "type": 301 }
      ],
      "cleanUrls": true
    }
  ]
}
