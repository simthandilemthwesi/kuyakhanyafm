{
  "hosting": {
    "public": "frontend/kuyakhanya-frontend/.next",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "node_modules/**"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }] },
      { "source": "/**", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] }
    ],
    "cleanUrls": true
  }
}