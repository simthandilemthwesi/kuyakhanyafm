{
  "version": 2,
  "builds": [
    { "src": "frontend/kuyakhanya-frontend/next.config.ts", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/_next/static/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}